Options -Indexes

<IfModule mod_headers.c>
    Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(?:\.git|\.github|app|database|docs|scripts|storage)(?:/|$) - [R=404,L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

<FilesMatch "^(?:db\.php|\.env|composer\.(?:json|lock))$">
    Require all denied
</FilesMatch>

RedirectMatch 404 ^/(?:\.git|\.github|app|database|docs|scripts|storage)(?:/|$)
